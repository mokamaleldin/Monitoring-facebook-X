{
  "name": "kashida-newsroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:demo": "NEXT_PUBLIC_DATA_MODE=demo next dev",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "local:supabase": "node scripts/local-supabase.mjs",
    "bootstrap": "node scripts/bootstrap-auth.mjs",
    "import:snapshot": "node scripts/import-snapshot.mjs --set-reference-date",
    "collect:facebook": "node scripts/collect-facebook.mjs",
    "start:api": "node server/node-server.ts",
    "serve:out": "node scripts/serve-out.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0"
  }
}
