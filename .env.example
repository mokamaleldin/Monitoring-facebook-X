# Public browser variables (safe for static export out/)
NEXT_PUBLIC_DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional override if hosting the standalone Node admin API separately from Supabase Edge Functions:
# NEXT_PUBLIC_ADMIN_API_URL=
# NEXT_PUBLIC_COLLECT_API_URL=

# Server-only secrets — NEVER commit values or expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
KASHIDA_TEST_ADMIN_PASSWORD=
KASHIDA_TEST_USER1_PASSWORD=
KASHIDA_TEST_USER2_PASSWORD=
SOCIALAPIS_API_KEY=
